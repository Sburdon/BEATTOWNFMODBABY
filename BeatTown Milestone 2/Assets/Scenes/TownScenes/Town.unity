--- !u!114 &1673584042
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1673584038}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3997b7c3d5e68425d8a28dcd92ec4249, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterDialogue: {fileID: 1384802726}
  characterLines:
  - speakerName: Gus
    line: OW! Those cod-dang fish! Thank you oddly muscular stranger.
    portrait: {fileID: 21300000, guid: dd730db3561c3014dbb4cafa3d350bb2, type: 3}
  - speakerName: John
    line: What was that about?
    portrait: {fileID: 21300000, guid: 7270cd6bddc57924da2d126737a2c130, type: 3}
  - speakerName: Gus
    line: You mean me being harassed? Just the daily life of a  fisherman around
      here.
    portrait: {fileID: 21300000, guid: dd730db3561c3014dbb4cafa3d350bb2, type: 3}
  - speakerName: John
    line: "That\u2019s a normal occurrence? "
    portrait: {fileID: 21300000, guid: 7270cd6bddc57924da2d126737a2c130, type: 3}
  - speakerName: Gus
    line: Around these parts? Yeah, but for some reason they have been more aggressive
      than usual.
    portrait: {fileID: 21300000, guid: dd730db3561c3014dbb4cafa3d350bb2, type: 3}
  - speakerName: Gus
    line: "It\u2019s almost as if someone is rallying them. A Fish-megadeon \u2026.just
      like papy used to say."
    portrait: {fileID: 21300000, guid: dd730db3561c3014dbb4cafa3d350bb2, type: 3}
  - speakerName: John
    line: ...
    portrait: {fileID: 21300000, guid: 7270cd6bddc57924da2d126737a2c130, type: 3}
  - speakerName: Gus
    line: Anyway you look like a strong looking lad. Will ya help me out?
    portrait: {fileID: 21300000, guid: 6fa6e3f8e9e3eaa499dc7344aeb0654d, type: 3}
  - speakerName: John
    line: Yeah, why not. How bad can some fish be?
    portrait: {fileID: 21300000, guid: 7270cd6bddc57924da2d126737a2c130, type: 3}
  director: {fileID: 1673584039}
  screenFader: {fileID: 579120072}
  nextSceneName: Scenes/Brady
  playerPosition: {fileID: 11400000, guid: 9b53adf02e9ad4368b151b0b533b1ddd, type: 2}
  player: {fileID: 90644245}
